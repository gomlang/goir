package opt;

use ecosystem::goir as ir;
use ecosystem::goir::analysis;

struct Available {
    value: ir::Value,
    block: isize,
}

fn graph_for_blocks(blocks: Vec[ir::BlockData], budget: Ref[isize]) -> Result[
    analysis::Graph,
    ir::Error,
] {
    let adjacency = Vec::new();
    for block in blocks {
        spend(budget)?;
        let destinations = Vec::new();
        for edge in ir::successors(terminator(block)?) {
            spend(budget)?;
            destinations.push(edge.target.index());
        }
        adjacency.push(destinations);
    }
    analysis::Graph::new(adjacency, budget)
}

fn expression_key(operation: ir::Operation) -> string {
    let normalized = match operation {
        Binary(op, left, right) => {
            let commutative = match op {
                Add | Mul | And | Or | Xor => true,
                _ => false,
            };
            if commutative && left.index() > right.index() {
                ir::Operation::Binary(op, right, left)
            } else {
                operation
            }
        },
        Compare(cc, left, right) => if (cc == ir::IntCC::Equal || cc == ir::IntCC::NotEqual)
            && left.index() > right.index() {
            ir::Operation::Compare(cc, right, left)
        } else {
            operation
        },
        _ => operation,
    };
    match normalized {
        Constant(ir::Datum::I64(value)) => f"i64:{value}",
        Constant(ir::Datum::I32(value)) => f"i32:{value}",
        Constant(ir::Datum::F64(value)) => f"f64:{float64_to_bits(value)}",
        Constant(ir::Datum::Bool(value)) => if value {
            "bool:true"
        } else {
            "bool:false"
        },
        Binary(op, left, right) => f"binary:{op.debug()}:{left.index()}:{right.index()}",
        Compare(cc, left, right) => f"compare:{cc.debug()}:{left.index()}:{right.index()}",
        Select(condition, yes, no) => f"select:{condition.index()}:{yes.index()}:{no.index()}",
        FloatBinary(op, left, right) => f"float:{op.debug()}:{left.index()}:{right.index()}",
        FloatCompare(cc, left, right) => f"float_compare:{cc.debug()}:{left.index()}:{right.index()}",
        Convert(conversion, value) => f"convert:{conversion.debug()}:{value.index()}",
        StackLoad(_) | StackStore(_, _) | Call(_, _) => "effectful",
    }
}

fn number_values(
    blocks: Vec[ir::BlockData],
    aliases: Vec[Option[ir::Value]],
    constants: Vec[Option[ir::Datum]],
    budget: Ref[isize],
) -> Result[Vec[ir::BlockData], ir::Error] {
    let graph = graph_for_blocks(blocks, budget)?;
    let expressions: HashMap[string, Vec[Available]] = HashMap::new();
    for index in graph.reverse_postorder() {
        let block = blocks[index];
        let instructions = Vec::new();
        for instruction in block.instructions {
            spend(budget)?;
            let operation = resolve_operation(instruction.operation, aliases, budget)?;
            if !operation.has_effects() && instruction.results.len() == 1 {
                let result = instruction.results[0];
                if aliases[result.index()].is_none() {
                    let key = expression_key(operation);
                    let candidates = expressions.get(key).unwrap_or(Vec::new());
                    let mut found = Option::None;
                    for candidate in candidates {
                        spend(budget)?;
                        if graph.dominates(candidate.block, index)? {
                            found = Option::Some(candidate.value);
                            break;
                        }
                    }
                    match found {
                        Option::Some(value) => {
                            aliases[result.index()] = Option::Some(value);
                        },
                        Option::None => {
                            candidates.push(Available { value: result, block: index });
                            expressions.insert(key, candidates);
                        },
                    }
                }
            }
            instructions.push(ir::Instruction { results: instruction.results, operation });
        }
        blocks[index] = ir::BlockData {
            id: block.id,
            parameters: block.parameters,
            instructions,
            terminator: block.terminator,
        };
    }
    for index in 0..blocks.len() {
        let block = blocks[index];
        let instructions = Vec::new();
        for instruction in block.instructions {
            spend(budget)?;
            instructions.push(
                ir::Instruction {
                    results: instruction.results,
                    operation: resolve_operation(instruction.operation, aliases, budget)?,
                },
            );
        }
        blocks[index] = ir::BlockData {
            id: block.id,
            parameters: block.parameters,
            instructions,
            terminator: Option::Some(resolve_term(terminator(block)?, aliases, constants, budget)?),
        };
    }
    Result::Ok(blocks)
}
