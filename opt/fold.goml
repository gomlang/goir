package opt;

use ecosystem::goir as ir;

enum Replacement {
    Keep,
    Alias(ir::Value),
    Constant(ir::Datum),
}

fn safe_to_fold(operation: ir::Operation, constants: Vec[Option[ir::Datum]]) -> bool {
    if !operation.has_effects() {
        return true
    }
    if let ir::Operation::Binary(op, left, right) = operation {
        if let (Some(a), Some(b)) = (constants[left.index()], constants[right.index()]) {
            return match ir::evaluate_binary(op, a, b) {
                Ok(_) => true,
                Err(_) => false,
            }
        }
    }
    false
}

fn integer(constants: Vec[Option[ir::Datum]], value: ir::Value) -> Option[i64] {
    match constants[value.index()] {
        Option::Some(ir::Datum::I64(value)) => Option::Some(value),
        Option::Some(ir::Datum::I32(value)) => Option::Some(value.to_i64()),
        _ => Option::None,
    }
}

fn constant_integer(value: i64) -> Replacement {
    Replacement::Constant(ir::Datum::I64(value))
}

fn typed_integer(value: i64, narrow: bool) -> Replacement {
    if narrow {
        Replacement::Constant(ir::Datum::I32(value.to_i32()))
    } else {
        constant_integer(value)
    }
}

fn fold_binary(
    narrow: bool,
    op: ir::BinaryOp,
    left: ir::Value,
    right: ir::Value,
    constants: Vec[Option[ir::Datum]],
) -> Replacement {
    let a = integer(constants, left);
    let b = integer(constants, right);
    match (constants[left.index()], constants[right.index()]) {
        (Option::Some(x), Option::Some(y)) => {
            return match ir::evaluate_binary(op, x, y) {
                Ok(value) => Replacement::Constant(value),
                Err(_) => Replacement::Keep,
            }
        },
        _ => (),
    }
    if left == right {
        match op {
            Sub | Xor => return typed_integer(0, narrow),
            And | Or | Smin | Smax | Umin | Umax => return Replacement::Alias(left),
            _ => (),
        }
    }
    match op {
        Add | Or | Xor => {
            if a == Option::Some(0) {
                return Replacement::Alias(right)
            }
            if b == Option::Some(0) {
                return Replacement::Alias(left)
            }
            if op == ir::BinaryOp::Or && (a == Option::Some(-1) || b == Option::Some(-1)) {
                return typed_integer(-1, narrow)
            }
        },
        Sub => {
            if b == Option::Some(0) {
                return Replacement::Alias(left)
            }
        },
        Mul => {
            if a == Option::Some(0) || b == Option::Some(0) {
                return typed_integer(0, narrow)
            }
            if a == Option::Some(1) {
                return Replacement::Alias(right)
            }
            if b == Option::Some(1) {
                return Replacement::Alias(left)
            }
        },
        And => {
            if a == Option::Some(0) || b == Option::Some(0) {
                return typed_integer(0, narrow)
            }
            if a == Option::Some(-1) {
                return Replacement::Alias(right)
            }
            if b == Option::Some(-1) {
                return Replacement::Alias(left)
            }
        },
        Shl | ShrU | ShrS | Rotl | Rotr => {
            if a == Option::Some(0) {
                return typed_integer(0, narrow)
            }
            if (op == ir::BinaryOp::ShrS || op == ir::BinaryOp::Rotl || op == ir::BinaryOp::Rotr)
                && a == Option::Some(-1) {
                return typed_integer(-1, narrow)
            }
            match b {
                Option::Some(count) => {
                    if (count.to_u64()
                        & if narrow {
                            31
                        } else {
                            63
                        })
                        == 0 {
                        return Replacement::Alias(left)
                    }
                },
                _ => (),
            }
        },
        Smin | Smax | Umin | Umax => {
            let minimum: i64 = if narrow {
                -2147483648
            } else {
                -9223372036854775808
            };
            let maximum: i64 = if narrow {
                2147483647
            } else {
                9223372036854775807
            };
            let (absorbing, identity) = match op {
                Smin => (minimum, maximum),
                Smax => (maximum, minimum),
                Umin => (0, -1),
                _ => (-1, 0),
            };
            if a == Option::Some(absorbing) || b == Option::Some(absorbing) {
                return typed_integer(absorbing, narrow)
            }
            if a == Option::Some(identity) {
                return Replacement::Alias(right)
            }
            if b == Option::Some(identity) {
                return Replacement::Alias(left)
            }
        },
        DivS | DivU | RemS | RemU | ShlChecked | ShrUChecked | ShrSChecked => (),
    }
    Replacement::Keep
}

fn fold(function: ir::Function, operation: ir::Operation, constants: Vec[Option[ir::Datum]]) -> Replacement {
    match operation {
        Constant(value) => Replacement::Constant(value),
        Call(_, _) | StackLoad(_) | StackStore(_, _) | FloatBinary(_, _, _) | FloatCompare(_, _, _) => Replacement::Keep,
        Unary(op, value) => match constants[value.index()] {
            Option::Some(input) => match ir::evaluate_unary(op, input) {
                Result::Ok(output) => Replacement::Constant(output),
                Result::Err(_) => Replacement::Keep,
            },
            Option::None => Replacement::Keep,
        },
        Convert(conversion, value) => fold_conversion(conversion, constants[value.index()]),
        Binary(op, left, right) => fold_binary(is_i32(function, left), op, left, right, constants),
        Compare(cc, left, right) => {
            if is_i32(function, left) {
                return fold_compare_i32(cc, left, right, constants)
            }
            let result = match (integer(constants, left), integer(constants, right)) {
                (Option::Some(a), Option::Some(b)) => Option::Some(
                    match cc {
                        Equal => a == b,
                        NotEqual => a != b,
                        SignedLess => a < b,
                        SignedLessEqual => a <= b,
                        UnsignedLess => a.to_u64() < b.to_u64(),
                        UnsignedLessEqual => a.to_u64() <= b.to_u64(),
                    },
                ),
                _ => if left == right {
                    Option::Some(
                        match cc {
                            Equal | SignedLessEqual | UnsignedLessEqual => true,
                            _ => false,
                        },
                    )
                } else {
                    Option::None
                },
            };
            match result {
                Option::Some(value) => Replacement::Constant(ir::Datum::Bool(value)),
                _ => Replacement::Keep,
            }
        },
        Select(condition, yes, no) => {
            if yes == no {
                return Replacement::Alias(yes)
            }
            match constants[condition.index()] {
                Option::Some(ir::Datum::Bool(value)) => return Replacement::Alias(
                    if value {
                        yes
                    } else {
                        no
                    },
                ),
                _ => (),
            }
            match (constants[yes.index()], constants[no.index()]) {
                (Option::Some(a), Option::Some(b)) => if a == b {
                    Replacement::Constant(a)
                } else {
                    Replacement::Keep
                },
                _ => Replacement::Keep,
            }
        },
    }
}

fn fold_conversion(conversion: ir::IntConversion, value: Option[ir::Datum]) -> Replacement {
    match (conversion, value) {
        (SignExtend, Option::Some(ir::Datum::I32(value))) => constant_integer(value.to_i64()),
        (ZeroExtend, Option::Some(ir::Datum::I32(value))) => constant_integer(
            value.to_u32().to_i64(),
        ),
        (Truncate, Option::Some(ir::Datum::I64(value))) => Replacement::Constant(
            ir::Datum::I32(value.to_i32()),
        ),
        _ => Replacement::Keep,
    }
}

fn fold_compare_i32(
    cc: ir::IntCC,
    left: ir::Value,
    right: ir::Value,
    constants: Vec[Option[ir::Datum]],
) -> Replacement {
    match (constants[left.index()], constants[right.index()]) {
        (Option::Some(ir::Datum::I32(a)), Option::Some(ir::Datum::I32(b))) => Replacement::Constant(
            ir::Datum::Bool(
                match cc {
                    Equal => a == b,
                    NotEqual => a != b,
                    SignedLess => a < b,
                    SignedLessEqual => a <= b,
                    UnsignedLess => a.to_u32() < b.to_u32(),
                    UnsignedLessEqual => a.to_u32() <= b.to_u32(),
                },
            ),
        ),
        _ => if left == right {
            Replacement::Constant(
                ir::Datum::Bool(
                    match cc {
                        Equal | SignedLessEqual | UnsignedLessEqual => true,
                        _ => false,
                    },
                ),
            )
        } else {
            Replacement::Keep
        },
    }
}

fn is_i32(function: ir::Function, value: ir::Value) -> bool {
    match function.value_type(value) {
        Ok(ty) => ty == ir::Type::I32,
        Err(_) => false,
    }
}
