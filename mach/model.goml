package mach;

use ecosystem::goir as ir;

#[derive(PartialEq, Eq, Hash)]
pub struct Reg {
    slot: isize,
    owner: Ref[()],
    class_value: RegClass,
}

#[derive(Debug, PartialEq, Eq, Hash)]
pub enum RegClass {
    Integer,
    Float,
}

impl Reg {
    pub fn class(self: Reg) -> RegClass {
        self.class_value
    }

    pub fn index(self: Reg) -> isize {
        self.slot
    }
}

impl Debug for Reg {
    fn debug(self: Reg) -> string {
        f"r{self.slot}"
    }
}

#[derive(Debug, PartialEq, Eq)]
pub enum FixedReg {
    AX,
    CX,
    DX,
    X0,
    X1,
    X2,
}

#[derive(Debug, PartialEq, Eq)]
pub enum OperandKind {
    Use,
    Def,
}

#[derive(Debug, PartialEq, Eq)]
pub enum OperandPosition {
    Early,
    Late,
}

#[derive(Debug, PartialEq, Eq)]
pub enum Constraint {
    Any,
    Register,
    Fixed(FixedReg),
    Reuse(isize),
}

#[derive(Debug, PartialEq, Eq)]
pub struct Operand {
    pub reg: Reg,
    pub kind: OperandKind,
    pub position: OperandPosition,
    pub constraint: Constraint,
}

#[derive(Debug, PartialEq, Eq)]
pub enum Clobber {
    Register(isize),
    Fixed(FixedReg),
    Flags,
}

pub enum Instruction {
    Immediate {
        dst: Reg,
        value: i64,
    },
    FloatImmediate {
        dst: Reg,
        bits: i64,
    },
    Binary {
        dst: Reg,
        op: ir::BinaryOp,
        left: Reg,
        right: Reg,
    },
    BinaryImmediate {
        dst: Reg,
        op: ir::BinaryOp,
        left: Reg,
        value: i64,
    },
    Lea {
        dst: Reg,
        value: Reg,
        scale: isize,
    },
    Compare {
        dst: Reg,
        cc: ir::IntCC,
        left: Reg,
        right: Reg,
    },
    Select {
        dst: Reg,
        condition: Reg,
        yes: Reg,
        no: Reg,
    },
    FloatBinary {
        dst: Reg,
        op: ir::FloatOp,
        left: Reg,
        right: Reg,
    },
    FloatCompare {
        dst: Reg,
        cc: ir::FloatCC,
        left: Reg,
        right: Reg,
    },
    FloatSelect {
        dst: Reg,
        condition: Reg,
        yes: Reg,
        no: Reg,
    },
    Convert {
        dst: Reg,
        op: ir::IntConversion,
        value: Reg,
    },
    StackLoad {
        dst: Reg,
        slot: ir::StackSlot,
    },
    StackStore {
        slot: ir::StackSlot,
        value: Reg,
    },
    Call {
        target: ir::FuncRef,
        arguments: Vec[Reg],
        results: Vec[Reg],
    },
}

impl Instruction {
    pub fn definitions(self: Instruction) -> Vec[Reg] {
        match self {
            Immediate { dst, .. } | FloatImmediate { dst, .. } | Binary { dst, .. } | BinaryImmediate {
                dst,
                ..,
            } | Lea { dst, .. } | Compare { dst, .. } | Select { dst, .. } | FloatBinary { dst, .. } | FloatCompare {
                dst,
                ..,
            } | FloatSelect { dst, .. } | Convert { dst, .. } | StackLoad { dst, .. } => Vec::from_array(
                [dst],
            ),
            StackStore { .. } => Vec::new(),
            Call { results, .. } => copy_vec(results),
        }
    }

    pub fn operands(self: Instruction) -> Vec[Operand] {
        let uses = self.uses();
        let constraints = match self {
            Immediate { .. } | FloatImmediate { .. } | StackLoad { .. } => Vec::new(),
            Binary { op, .. } => Vec::from_array(
                [
                    Constraint::Register,
                    match op {
                        Shl | ShrU | ShrS => Constraint::Fixed(FixedReg::CX),
                        _ => Constraint::Any,
                    },
                ],
            ),
            BinaryImmediate { .. } | Lea { .. } => Vec::from_array([Constraint::Register]),
            Compare { .. } | FloatBinary { .. } => Vec::from_array(
                [Constraint::Register, Constraint::Any],
            ),
            Select { .. } => Vec::from_array(
                [Constraint::Any, Constraint::Register, Constraint::Any],
            ),
            FloatCompare { .. } => Vec::from_array(
                [Constraint::Fixed(FixedReg::X0), Constraint::Fixed(FixedReg::X1)],
            ),
            FloatSelect { .. } => Vec::from_array(
                [Constraint::Any, Constraint::Fixed(FixedReg::X0), Constraint::Fixed(FixedReg::X1)],
            ),
            Convert { .. } | StackStore { .. } => Vec::from_array([Constraint::Any]),
            Call { .. } => {
                let constraints = Vec::new();
                for _ in uses {
                    constraints.push(Constraint::Any);
                }
                constraints
            },
        };
        let output = Vec::new();
        for index in 0..uses.len() {
            output.push(
                Operand {
                    reg: uses[index],
                    kind: OperandKind::Use,
                    position: OperandPosition::Early,
                    constraint: constraints[index],
                },
            );
        }
        let constraint = match self {
            Binary { .. } | BinaryImmediate { .. } | FloatBinary { .. } => Constraint::Reuse(0),
            Compare { .. } | FloatCompare { .. } => Constraint::Fixed(FixedReg::AX),
            Select { .. } => Constraint::Reuse(1),
            FloatSelect { .. } => Constraint::Fixed(FixedReg::X0),
            Call { .. } => Constraint::Any,
            _ => Constraint::Register,
        };
        for reg in self.definitions() {
            output.push(
                Operand { reg, kind: OperandKind::Def, position: OperandPosition::Late, constraint },
            );
        }
        output
    }

    pub fn clobbers(self: Instruction) -> Vec[Clobber] {
        match self {
            Immediate { .. } | Lea { .. } | StackLoad { .. } | Convert { .. } => Vec::new(),
            StackStore { .. } => Vec::from_array([Clobber::Fixed(FixedReg::AX)]),
            FloatImmediate { .. } => Vec::from_array([Clobber::Fixed(FixedReg::AX)]),
            FloatBinary { .. } => Vec::new(),
            FloatCompare { .. } => Vec::from_array([Clobber::Flags, Clobber::Fixed(FixedReg::DX)]),
            Call { .. } => {
                let output = Vec::new();
                for index in 0..14 {
                    output.push(Clobber::Register(index));
                }
                for register in Vec::from_array(
                    [
                        FixedReg::AX,
                        FixedReg::CX,
                        FixedReg::DX,
                        FixedReg::X0,
                        FixedReg::X1,
                        FixedReg::X2,
                    ],
                ) {
                    output.push(Clobber::Fixed(register));
                }
                output.push(Clobber::Flags);
                output
            },
            _ => Vec::from_array([Clobber::Flags]),
        }
    }

    pub fn uses(self: Instruction) -> Vec[Reg] {
        match self {
            Immediate { .. } | FloatImmediate { .. } | StackLoad { .. } => Vec::new(),
            Binary { left, right, .. } | Compare { left, right, .. } | FloatBinary {
                left,
                right,
                ..,
            } | FloatCompare { left, right, .. } => Vec::from_array([left, right]),
            BinaryImmediate { left, .. } => Vec::from_array([left]),
            Lea { value, .. } | Convert { value, .. } | StackStore { value, .. } => Vec::from_array(
                [value],
            ),
            Select { condition, yes, no, .. } | FloatSelect { condition, yes, no, .. } => Vec::from_array(
                [condition, yes, no],
            ),
            Call { arguments, .. } => copy_vec(arguments),
        }
    }
}

pub struct Copy {
    pub source: Reg,
    pub destination: Reg,
}

pub struct Edge {
    pub target: isize,
    pub copies: Vec[Copy],
}

pub enum Terminator {
    Jump(Edge),
    Branch {
        condition: Reg,
        yes: Edge,
        no: Edge,
    },
    CompareBranch {
        cc: ir::IntCC,
        left: Reg,
        right: Reg,
        yes: Edge,
        no: Edge,
    },
    Return(Vec[Reg]),
}

impl Terminator {
    pub fn successors(self: Terminator) -> Vec[Edge] {
        match self {
            Jump(edge) => Vec::from_array([copy_edge(edge)]),
            Branch { yes, no, .. } | CompareBranch { yes, no, .. } => Vec::from_array(
                [copy_edge(yes), copy_edge(no)],
            ),
            Return(_) => Vec::new(),
        }
    }

    pub fn uses(self: Terminator) -> Vec[Reg] {
        let values = match self {
            Return(values) => copy_vec(values),
            Branch { condition, .. } => Vec::from_array([condition]),
            CompareBranch { left, right, .. } => Vec::from_array([left, right]),
            _ => Vec::new(),
        };
        for edge in self.successors() {
            for value in edge.copies {
                values.push(value.source);
            }
        }
        values
    }
}

pub struct Block {
    pub index: isize,
    pub parameters: Vec[Reg],
    pub instructions: Vec[Instruction],
    pub terminator: Terminator,
}

pub struct Function {
    source_value: ir::Function,
    identity: Ref[()],
    body: Vec[Block],
    types: Vec[ir::Type],
}

fn copy_vec[T](input: Vec[T]) -> Vec[T] {
    let output = Vec::new();
    for value in input {
        output.push(value);
    }
    output
}

fn copy_instruction(instruction: Instruction) -> Instruction {
    match instruction {
        Call { target, arguments, results } => Instruction::Call {
            target,
            arguments: copy_vec(arguments),
            results: copy_vec(results),
        },
        _ => instruction,
    }
}

fn copy_edge(edge: Edge) -> Edge {
    Edge { target: edge.target, copies: copy_vec(edge.copies) }
}

fn copy_term(term: Terminator) -> Terminator {
    match term {
        Jump(edge) => Terminator::Jump(copy_edge(edge)),
        Branch { condition, yes, no } => Terminator::Branch {
            condition,
            yes: copy_edge(yes),
            no: copy_edge(no),
        },
        CompareBranch { cc, left, right, yes, no } => Terminator::CompareBranch {
            cc,
            left,
            right,
            yes: copy_edge(yes),
            no: copy_edge(no),
        },
        Return(values) => Terminator::Return(copy_vec(values)),
    }
}

impl Function {
    pub fn source(self: Function) -> ir::Function {
        self.source_value
    }

    pub fn register_count(self: Function) -> isize {
        self.types.len()
    }

    pub fn register(self: Function, index: isize) -> Result[Reg, ir::Error] {
        if index < 0 || index >= self.types.len() {
            return Result::Err(ir::error(ir::ErrorKind::InvalidHandle, "invalid machine register"))
        }
        Result::Ok(
            Reg {
                slot: index,
                owner: self.identity,
                class_value: class_for_type(self.types[index]),
            },
        )
    }

    pub fn register_type(self: Function, reg: Reg) -> Result[ir::Type, ir::Error] {
        if !ptr_eq(reg.owner, self.identity) {
            return Result::Err(
                ir::error(
                    ir::ErrorKind::WrongFunction,
                    "register belongs to another machine function",
                ),
            )
        }
        self.register(reg.slot)?;
        Result::Ok(self.types[reg.slot])
    }

    pub fn blocks(self: Function) -> Vec[Block] {
        let blocks = Vec::new();
        for block in self.body {
            let instructions = Vec::new();
            for instruction in block.instructions {
                instructions.push(copy_instruction(instruction));
            }
            blocks.push(
                Block {
                    index: block.index,
                    parameters: copy_vec(block.parameters),
                    instructions,
                    terminator: copy_term(block.terminator),
                },
            );
        }
        blocks
    }
}

fn class_for_type(ty: ir::Type) -> RegClass {
    if ty == ir::Type::F64 {
        RegClass::Float
    } else {
        RegClass::Integer
    }
}
