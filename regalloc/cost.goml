package regalloc;

use ecosystem::goir as ir;
use module::mach;
use module::analysis;

fn allocation_graph(function: mach::Function, budget: Ref[isize]) -> Result[
    analysis::Graph,
    ir::Error,
] {
    let successors = Vec::new();
    for block in function.blocks() {
        let targets = Vec::new();
        for edge in block.terminator.successors() {
            spend(budget)?;
            targets.push(edge.target);
        }
        successors.push(targets);
    }
    analysis::Graph::new(successors, budget)
}

fn value_weights(function: mach::Function, block_weights: Vec[isize], budget: Ref[isize]) -> Result[
    Vec[isize],
    ir::Error,
] {
    let output = Vec::new();
    for _ in 0..function.register_count() {
        output.push(1);
    }
    for block in function.blocks() {
        for instruction in block.instructions {
            for reg in instruction.uses() {
                spend(budget)?;
                output[reg.index()] = output[reg.index()] + block_weights[block.index];
            }
        }
        for reg in block.terminator.uses() {
            spend(budget)?;
            output[reg.index()] = output[reg.index()] + block_weights[block.index];
        }
    }
    Result::Ok(output)
}

fn constants_for(function: mach::Function) -> Vec[Option[i64]] {
    let output = Vec::new();
    for _ in 0..function.register_count() {
        output.push(Option::None);
    }
    for block in function.blocks() {
        for instruction in block.instructions {
            match instruction {
                Immediate { dst, value } => {
                    output[dst.index()] = Option::Some(value);
                },
                FloatImmediate { dst, bits } => {
                    output[dst.index()] = Option::Some(bits);
                },
                _ => (),
            }
        }
    }
    output
}
