package regalloc;

use ecosystem::goir as ir;
use module::mach;

#[derive(Debug, PartialEq, Eq)]
pub enum Location {
    Register(isize),
    Stack(isize),
    Fixed(mach::FixedReg),
}

pub struct Options {
    pub registers: isize,
    pub max_steps: isize,
}

impl Options {
    pub fn standard() -> Options {
        Options { registers: 7, max_steps: 10000000 }
    }
}

pub struct Allocation {
    machine: mach::Function,
    locations: Vec[Location],
    live: Liveness,
    register_limit: isize,
    slots: isize,
    spilled_values: isize,
    plan: Vec[AllocatedBlock],
}

impl Allocation {
    pub fn blocks(self: Allocation) -> Vec[AllocatedBlock] {
        copy_plan(self.plan)
    }

    pub fn function(self: Allocation) -> mach::Function {
        self.machine
    }

    pub fn location(self: Allocation, reg: mach::Reg) -> Result[Location, ir::Error] {
        self.machine.register_type(reg)?;
        Result::Ok(self.locations[reg.index()])
    }

    pub fn stack_slots(self: Allocation) -> isize {
        self.slots
    }

    pub fn spill_count(self: Allocation) -> isize {
        self.spilled_values
    }

    pub fn register_count(self: Allocation) -> isize {
        self.register_limit
    }

    pub fn liveness(self: Allocation) -> Liveness {
        self.live
    }
}

pub fn allocate(function: mach::Function) -> Result[Allocation, ir::Error] {
    allocate_with_options(function, Options::standard())
}

fn lane_available(live: Liveness, owners: Vec[mach::Reg], reg: mach::Reg, budget: Ref[isize]) -> Result[
    bool,
    ir::Error,
] {
    for owner in owners {
        spend(budget)?;
        if interferes(live, owner, reg, budget)? {
            return Result::Ok(false)
        }
    }
    Result::Ok(true)
}

fn drop_expired(live: Liveness, owners: Vec[mach::Reg], start: isize, budget: Ref[isize]) -> Result[
    (),
    ir::Error,
] {
    let mut index = owners.len();
    while index > 0 {
        index = index - 1;
        spend(budget)?;
        if live.hulls[owners[index].index()].end < start {
            let _ = owners.remove(index);
        }
    }
    Result::Ok(())
}

pub fn allocate_with_options(function: mach::Function, options: Options) -> Result[
    Allocation,
    ir::Error,
] {
    if options.registers < 0 || options.registers > 7 || options.max_steps < 1
        || options.max_steps > 100000000 {
        return Result::Err(
            ir::error(ir::ErrorKind::InvalidArgument, "invalid register allocation options"),
        )
    }
    let budget = Ref::new(options.max_steps);
    let live = analyze_with_budget(function, budget)?;
    let hints = preferences(function, budget)?;
    let lanes: Vec[Vec[mach::Reg]] = Vec::new();
    for _ in 0..options.registers {
        lanes.push(Vec::new());
    }
    let slot_owners: Vec[Vec[mach::Reg]] = Vec::new();
    let active_slots: Vec[Vec[mach::Reg]] = Vec::new();
    let locations = Vec::new();
    let homes = Vec::new();
    for _ in 0..function.register_count() {
        locations.push(Location::Stack(-1));
        homes.push(-1);
    }
    for interval in live.ranges {
        let mut selected = -1;
        for hint in hints[interval.reg.index()] {
            spend(budget)?;
            match locations[hint.index()] {
                Register(index) => {
                    drop_expired(live, lanes[index], interval.start, budget)?;
                    if lane_available(live, lanes[index], interval.reg, budget)? {
                        selected = index;
                        break;
                    }
                },
                _ => (),
            }
        }
        if selected < 0 {
            for index in 0..lanes.len() {
                drop_expired(live, lanes[index], interval.start, budget)?;
                if lane_available(live, lanes[index], interval.reg, budget)? {
                    selected = index;
                    break;
                }
            }
        }
        if selected >= 0 {
            lanes[selected].push(interval.reg);
            locations[interval.reg.index()] = Location::Register(selected);
        } else {
            let mut slot = -1;
            for index in 0..slot_owners.len() {
                drop_expired(live, active_slots[index], interval.start, budget)?;
                if lane_available(live, active_slots[index], interval.reg, budget)? {
                    slot = index;
                    break;
                }
            }
            if slot < 0 {
                slot = slot_owners.len();
                slot_owners.push(Vec::new());
                active_slots.push(Vec::new());
            }
            slot_owners[slot].push(interval.reg);
            active_slots[slot].push(interval.reg);
            locations[interval.reg.index()] = Location::Stack(slot);
            homes[interval.reg.index()] = slot;
        }
    }
    let plan = allocate_plan(
        function,
        live,
        locations,
        homes,
        slot_owners,
        options.registers,
        budget,
    )?;
    let mut spilled_values = 0;
    for home in homes {
        if home >= 0 {
            spilled_values = spilled_values + 1;
        }
    }
    let allocation = Allocation {
        machine: function,
        locations,
        live,
        register_limit: options.registers,
        slots: slot_owners.len(),
        spilled_values,
        plan,
    };
    verify_with_budget(allocation, budget)?;
    Result::Ok(allocation)
}

pub fn verify(allocation: Allocation) -> Result[(), ir::Error] {
    verify_with_budget(allocation, Ref::new(10000000))
}

fn verify_with_budget(allocation: Allocation, budget: Ref[isize]) -> Result[(), ir::Error] {
    if allocation.locations.len() != allocation.machine.register_count()
        || allocation.register_limit < 0
        || allocation.register_limit > 7
        || allocation.slots < 0
        || allocation.slots > allocation.locations.len() {
        return Result::Err(ir::error(ir::ErrorKind::InvalidArgument, "invalid allocation shape"))
    }
    let lanes: Vec[Vec[mach::Reg]] = Vec::new();
    for _ in 0..allocation.register_limit + allocation.slots {
        lanes.push(Vec::new());
    }
    for interval in allocation.live.ranges {
        let location = allocation.location(interval.reg)?;
        let lane = match location {
            Register(index) => {
                if index < 0 || index >= allocation.register_limit {
                    return Result::Err(
                        ir::error(ir::ErrorKind::InvalidHandle, "invalid physical register"),
                    )
                }
                index
            },
            Stack(index) => {
                if index < 0 || index >= allocation.slots {
                    return Result::Err(
                        ir::error(ir::ErrorKind::InvalidHandle, "invalid spill slot"),
                    )
                }
                allocation.register_limit + index
            },
            Fixed(_) => return Result::Err(
                ir::error(ir::ErrorKind::InvalidHandle, "fixed register cannot be a canonical home"),
            ),
        };
        drop_expired(allocation.live, lanes[lane], interval.start, budget)?;
        if !lane_available(allocation.live, lanes[lane], interval.reg, budget)? {
            return Result::Err(
                ir::error(ir::ErrorKind::InvalidState, "overlapping live segments share a location"),
            )
        }
        lanes[lane].push(interval.reg);
    }
    check_with_budget(allocation, budget)
}
