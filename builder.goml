package goir;

pub struct Builder {
    function: Function,
    current: Ref[Block],
    finished: Ref[bool],
}

impl Builder {
    pub fn new(name: string, inputs: Vec[Type], outputs: Vec[Type]) -> Result[Builder, Error] {
        Builder::with_limits(name, inputs, outputs, Limits::standard())
    }

    pub fn with_limits(name: string, inputs: Vec[Type], outputs: Vec[Type], limits: Limits) -> Result[
        Builder,
        Error,
    ] {
        if name.len() == 0 || name.len() > 128 {
            return Result::Err(
                error(ErrorKind::InvalidArgument, "function name must contain 1..128 bytes"),
            )
        }
        if limits.max_blocks < 1 || limits.max_blocks > 1024 || limits.max_values < 1
            || limits.max_values > 65536
            || limits.max_block_parameters < 0
            || limits.max_block_parameters > 1024
            || limits.max_signature_values < 0
            || limits.max_signature_values > 1024
            || limits.max_verify_steps < 1
            || limits.max_verify_steps > 100000000 {
            return Result::Err(error(ErrorKind::InvalidArgument, "invalid IR limits"))
        }
        if inputs.len() > limits.max_signature_values || outputs.len() > limits.max_signature_values
            || inputs.len() > limits.max_values
            || inputs.len() > limits.max_block_parameters {
            return Result::Err(error(ErrorKind::LimitExceeded, "function signature exceeds limits"))
        }
        let identity = Ref::new(());
        let entry = Block { slot: 0, owner: identity };
        let values = Vec::new();
        let parameters = Vec::new();
        for ty in inputs {
            parameters.push(Value { slot: values.len(), owner: identity });
            values.push(ValueData { ty, block: entry, position: -1 });
        }
        let function = Function {
            identity,
            module_identity: Option::None,
            name_value: name,
            inputs: copy_vec(inputs),
            outputs: copy_vec(outputs),
            body: Vec::from_array(
                [
                    BlockData {
                        id: entry,
                        parameters,
                        instructions: Vec::new(),
                        terminator: Option::None,
                    },
                ],
            ),
            values,
            slots: Vec::new(),
            limits,
        };
        Result::Ok(Builder { function, current: Ref::new(entry), finished: Ref::new(false) })
    }

    pub fn entry(self: Builder) -> Block {
        self.function.body[0].id
    }

    pub fn parameters(self: Builder, block: Block) -> Result[Vec[Value], Error] {
        check_block(self.function, block)?;
        Result::Ok(copy_vec(self.function.body[block.slot].parameters))
    }

    pub fn append_block(self: Builder, types: Vec[Type]) -> Result[Block, Error] {
        self.require_open()?;
        let function = self.function;
        if function.body.len() >= function.limits.max_blocks
            || types.len() > function.limits.max_block_parameters
            || types.len() > function.limits.max_values - function.values.len() {
            return Result::Err(error(ErrorKind::LimitExceeded, "block exceeds IR limits"))
        }
        let block = Block { slot: function.body.len(), owner: function.identity };
        let parameters = Vec::new();
        for ty in types {
            parameters.push(Value { slot: function.values.len(), owner: function.identity });
            function.values.push(ValueData { ty, block, position: -1 });
        }
        function.body.push(
            BlockData { id: block, parameters, instructions: Vec::new(), terminator: Option::None },
        );
        Result::Ok(block)
    }

    pub fn switch_to(self: Builder, block: Block) -> Result[(), Error] {
        self.require_open()?;
        check_block(self.function, block)?;
        self.current.set(block);
        Result::Ok(())
    }

    pub fn for_function(target: FuncRef) -> Result[Builder, Error] {
        let signature = target.signature();
        let mut builder = Builder::new(
            target.name(),
            signature.parameter_types(),
            signature.result_types(),
        )?;
        let mut function = builder.function;
        function.module_identity = Option::Some(target.owner);
        builder.function = function;
        Result::Ok(builder)
    }

    pub fn ins(self: Builder, operation: Operation) -> Result[Value, Error] {
        self.require_insertion()?;
        let types = operation_types(self.function, operation)?;
        if types.len() != 1 || operation.effects().call || operation.effects().writes_memory {
            return Result::Err(
                error(
                    ErrorKind::InvalidArgument,
                    "ins requires a scalar operation; use call or stack_store for effects",
                ),
            )
        }
        Result::Ok(self.insert(operation, types)?[0])
    }

    pub fn call(self: Builder, target: FuncRef, arguments: Vec[Value]) -> Result[Vec[Value], Error] {
        self.require_insertion()?;
        let operation = Operation::Call(target, copy_vec(arguments));
        let types = operation_types(self.function, operation)?;
        self.insert(operation, types)
    }

    fn insert(self: Builder, operation: Operation, types: Vec[Type]) -> Result[Vec[Value], Error] {
        let function = self.function;
        if types.len() > function.limits.max_values - function.values.len()
            || function.body[self.current.get().slot].instructions.len()
                >= function.limits.max_values {
            return Result::Err(error(ErrorKind::LimitExceeded, "instruction exceeds IR limits"))
        }
        let block = self.current.get();
        let results = Vec::new();
        for ty in types {
            let value = Value { slot: function.values.len(), owner: function.identity };
            function.values.push(
                ValueData { ty, block, position: function.body[block.slot].instructions.len() },
            );
            results.push(value);
        }
        function.body[block.slot].instructions.push(
            Instruction { results, operation: copy_operation(operation) },
        );
        Result::Ok(copy_vec(results))
    }

    pub fn iconst(self: Builder, value: i64) -> Result[Value, Error] {
        self.ins(Operation::Constant(Datum::I64(value)))
    }

    pub fn i32const(self: Builder, value: i32) -> Result[Value, Error] {
        self.ins(Operation::Constant(Datum::I32(value)))
    }

    pub fn fconst(self: Builder, value: f64) -> Result[Value, Error] {
        self.ins(Operation::Constant(Datum::F64(value)))
    }

    pub fn fbinary(self: Builder, op: FloatOp, left: Value, right: Value) -> Result[Value, Error] {
        self.ins(Operation::FloatBinary(op, left, right))
    }

    pub fn fcmp(self: Builder, cc: FloatCC, left: Value, right: Value) -> Result[Value, Error] {
        self.ins(Operation::FloatCompare(cc, left, right))
    }

    pub fn convert(self: Builder, conversion: IntConversion, value: Value) -> Result[Value, Error] {
        self.ins(Operation::Convert(conversion, value))
    }

    pub fn stack_slot(self: Builder, ty: Type) -> Result[StackSlot, Error] {
        self.require_open()?;
        if self.function.slots.len() >= self.function.limits.max_values
            || self.function.slots.len() >= 4096 {
            return Result::Err(error(ErrorKind::LimitExceeded, "stack slot limit exceeded"))
        }
        let slot = StackSlot { slot: self.function.slots.len(), owner: self.function.identity };
        self.function.slots.push(ty);
        Result::Ok(slot)
    }

    pub fn stack_load(self: Builder, slot: StackSlot) -> Result[Value, Error] {
        self.ins(Operation::StackLoad(slot))
    }

    pub fn stack_store(self: Builder, slot: StackSlot, value: Value) -> Result[(), Error] {
        self.require_insertion()?;
        let operation = Operation::StackStore(slot, value);
        let types = operation_types(self.function, operation)?;
        let _ = self.insert(operation, types)?;
        Result::Ok(())
    }

    pub fn bconst(self: Builder, value: bool) -> Result[Value, Error] {
        self.ins(Operation::Constant(Datum::Bool(value)))
    }

    pub fn binary(self: Builder, op: BinaryOp, left: Value, right: Value) -> Result[Value, Error] {
        self.ins(Operation::Binary(op, left, right))
    }

    pub fn icmp(self: Builder, cc: IntCC, left: Value, right: Value) -> Result[Value, Error] {
        self.ins(Operation::Compare(cc, left, right))
    }

    pub fn select(self: Builder, condition: Value, yes: Value, no: Value) -> Result[Value, Error] {
        self.ins(Operation::Select(condition, yes, no))
    }

    pub fn terminate(self: Builder, term: Terminator) -> Result[(), Error] {
        self.require_insertion()?;
        check_terminator(self.function, term)?;
        let index = self.current.get().slot;
        let mut block = self.function.body[index];
        block.terminator = Option::Some(copy_terminator(term));
        self.function.body[index] = block;
        Result::Ok(())
    }

    pub fn jump(self: Builder, target: Block, arguments: Vec[Value]) -> Result[(), Error] {
        self.terminate(Terminator::Jump(Edge { target, arguments }))
    }

    pub fn branch(self: Builder, condition: Value, yes: Edge, no: Edge) -> Result[(), Error] {
        self.terminate(Terminator::Branch(condition, yes, no))
    }

    pub fn ret(self: Builder, values: Vec[Value]) -> Result[(), Error] {
        self.terminate(Terminator::Return(values))
    }

    pub fn finish(self: Builder) -> Result[Function, Error] {
        self.require_open()?;
        verify(self.function)?;
        self.finished.set(true);
        Result::Ok(self.function)
    }

    fn require_open(self: Builder) -> Result[(), Error] {
        if self.finished.get() {
            return Result::Err(error(ErrorKind::InvalidState, "builder is already finished"))
        }
        Result::Ok(())
    }

    fn require_insertion(self: Builder) -> Result[(), Error] {
        self.require_open()?;
        if self.function.body[self.current.get().slot].terminator.is_some() {
            return Result::Err(error(ErrorKind::InvalidState, "block already has a terminator"))
        }
        Result::Ok(())
    }
}
