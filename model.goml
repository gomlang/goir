package goir;

#[derive(Debug, PartialEq, Eq)]
pub enum Type {
    I64,
    I32,
    F64,
    Bool,
}

#[derive(Debug, PartialEq, Eq)]
pub enum BinaryOp {
    Add,
    Sub,
    Mul,
    And,
    Or,
    Xor,
    Shl,
    ShrU,
    ShrS,
    DivS,
    DivU,
    RemS,
    RemU,
    ShlChecked,
    ShrUChecked,
    ShrSChecked,
}

#[derive(Debug, PartialEq, Eq)]
pub enum IntCC {
    Equal,
    NotEqual,
    SignedLess,
    SignedLessEqual,
    UnsignedLess,
    UnsignedLessEqual,
}

#[derive(Debug, PartialEq, Eq)]
pub enum FloatOp {
    Add,
    Sub,
    Mul,
    Div,
}

#[derive(Debug, PartialEq, Eq)]
pub enum FloatCC {
    Equal,
    NotEqual,
    Less,
    LessEqual,
}

#[derive(Debug, PartialEq, Eq)]
pub enum IntConversion {
    SignExtend,
    ZeroExtend,
    Truncate,
}

#[derive(Debug, PartialEq, Eq)]
pub struct Effects {
    pub reads_memory: bool,
    pub writes_memory: bool,
    pub may_trap: bool,
    pub call: bool,
}

#[derive(PartialEq, Eq, Hash)]
pub struct StackSlot {
    slot: isize,
    owner: Ref[()],
}

impl StackSlot {
    pub fn index(self: StackSlot) -> isize {
        self.slot
    }
}

impl Debug for StackSlot {
    fn debug(self: StackSlot) -> string {
        f"slot{self.slot}"
    }
}

#[derive(PartialEq, Eq, Hash)]
pub struct Value {
    slot: isize,
    owner: Ref[()],
}

#[derive(PartialEq, Eq, Hash)]
pub struct Block {
    slot: isize,
    owner: Ref[()],
}

impl Value {
    pub fn index(self: Value) -> isize {
        self.slot
    }
}

impl Block {
    pub fn index(self: Block) -> isize {
        self.slot
    }
}

impl Debug for Value {
    fn debug(self: Value) -> string {
        f"v{self.slot}"
    }
}

impl Debug for Block {
    fn debug(self: Block) -> string {
        f"block{self.slot}"
    }
}

#[derive(Debug, PartialEq)]
pub enum ErrorKind {
    InvalidArgument,
    WrongFunction,
    InvalidHandle,
    InvalidState,
    TypeMismatch,
    ControlFlow,
    Dominance,
    LimitExceeded,
    FuelExhausted,
    ArithmeticTrap,
    Unsupported,
}

#[derive(Debug, PartialEq)]
pub struct Error {
    pub kind: ErrorKind,
    pub message: string,
}

impl ToString for Error {
    fn to_string(self: Error) -> string {
        self.message
    }
}

pub fn error(kind: ErrorKind, message: string) -> Error {
    Error { kind, message }
}

#[derive(Debug)]
pub enum Datum {
    I64(i64),
    I32(i32),
    F64(f64),
    Bool(bool),
}

impl Datum {
    pub fn value_type(self: Datum) -> Type {
        match self {
            I64(_) => Type::I64,
            I32(_) => Type::I32,
            F64(_) => Type::F64,
            Bool(_) => Type::Bool,
        }
    }
}

pub enum Operation {
    Constant(Datum),
    Binary(BinaryOp, Value, Value),
    Compare(IntCC, Value, Value),
    Select(Value, Value, Value),
    FloatBinary(FloatOp, Value, Value),
    FloatCompare(FloatCC, Value, Value),
    Convert(IntConversion, Value),
    StackLoad(StackSlot),
    StackStore(StackSlot, Value),
    Call(FuncRef, Vec[Value]),
}

pub struct Instruction {
    pub results: Vec[Value],
    pub operation: Operation,
}

pub struct Edge {
    pub target: Block,
    pub arguments: Vec[Value],
}

pub enum Terminator {
    Jump(Edge),
    Branch(Value, Edge, Edge),
    Return(Vec[Value]),
}

pub struct BlockData {
    pub id: Block,
    pub parameters: Vec[Value],
    pub instructions: Vec[Instruction],
    pub terminator: Option[Terminator],
}

struct ValueData {
    ty: Type,
    block: Block,
    position: isize,
}

pub struct Limits {
    pub max_blocks: isize,
    pub max_values: isize,
    pub max_block_parameters: isize,
    pub max_signature_values: isize,
    pub max_verify_steps: isize,
}

impl Limits {
    pub fn standard() -> Limits {
        Limits {
            max_blocks: 256,
            max_values: 4096,
            max_block_parameters: 256,
            max_signature_values: 256,
            max_verify_steps: 10000000,
        }
    }
}

pub struct Function {
    identity: Ref[()],
    module_identity: Option[Ref[()]],
    name_value: string,
    inputs: Vec[Type],
    outputs: Vec[Type],
    body: Vec[BlockData],
    values: Vec[ValueData],
    slots: Vec[Type],
    limits: Limits,
}

fn copy_vec[T](values: Vec[T]) -> Vec[T] {
    let output = Vec::new();
    for value in values {
        output.push(value);
    }
    output
}

fn copy_edge(edge: Edge) -> Edge {
    Edge { target: edge.target, arguments: copy_vec(edge.arguments) }
}

fn copy_terminator(term: Terminator) -> Terminator {
    match term {
        Jump(edge) => Terminator::Jump(copy_edge(edge)),
        Branch(condition, yes, no) => Terminator::Branch(condition, copy_edge(yes), copy_edge(no)),
        Return(values) => Terminator::Return(copy_vec(values)),
    }
}

fn copy_operation(operation: Operation) -> Operation {
    match operation {
        Call(target, arguments) => Operation::Call(target, copy_vec(arguments)),
        _ => operation,
    }
}

fn copy_instruction(instruction: Instruction) -> Instruction {
    Instruction {
        results: copy_vec(instruction.results),
        operation: copy_operation(instruction.operation),
    }
}

fn copy_block(block: BlockData) -> BlockData {
    let instructions = Vec::new();
    for instruction in block.instructions {
        instructions.push(copy_instruction(instruction));
    }
    BlockData {
        id: block.id,
        parameters: copy_vec(block.parameters),
        instructions,
        terminator: block.terminator.map(|term| copy_terminator(term)),
    }
}

impl Function {
    pub fn name(self: Function) -> string {
        self.name_value
    }

    pub fn parameter_types(self: Function) -> Vec[Type] {
        copy_vec(self.inputs)
    }

    pub fn result_types(self: Function) -> Vec[Type] {
        copy_vec(self.outputs)
    }

    pub fn stack_slots(self: Function) -> Vec[StackSlot] {
        let output = Vec::new();
        for index in 0..self.slots.len() {
            output.push(StackSlot { slot: index, owner: self.identity });
        }
        output
    }

    pub fn stack_slot_type(self: Function, slot: StackSlot) -> Result[Type, Error] {
        check_stack_slot(self, slot)?;
        Result::Ok(self.slots[slot.slot])
    }

    pub fn value_count(self: Function) -> isize {
        self.values.len()
    }

    pub fn blocks(self: Function) -> Vec[BlockData] {
        let output = Vec::new();
        for block in self.body {
            output.push(copy_block(block));
        }
        output
    }

    pub fn value_type(self: Function, value: Value) -> Result[Type, Error] {
        check_value(self, value)?;
        Result::Ok(self.values[value.slot].ty)
    }
}

fn check_value(function: Function, value: Value) -> Result[(), Error] {
    if !ptr_eq(function.identity, value.owner) {
        return Result::Err(error(ErrorKind::WrongFunction, "value belongs to another function"))
    }
    if value.slot < 0 || value.slot >= function.values.len() {
        return Result::Err(error(ErrorKind::InvalidHandle, "invalid value"))
    }
    Result::Ok(())
}

fn check_block(function: Function, block: Block) -> Result[(), Error] {
    if !ptr_eq(function.identity, block.owner) {
        return Result::Err(error(ErrorKind::WrongFunction, "block belongs to another function"))
    }
    if block.slot < 0 || block.slot >= function.body.len() {
        return Result::Err(error(ErrorKind::InvalidHandle, "invalid block"))
    }
    Result::Ok(())
}

pub fn operands(operation: Operation) -> Vec[Value] {
    match operation {
        Constant(_) | StackLoad(_) => Vec::new(),
        Convert(_, value) | StackStore(_, value) => Vec::from_array([value]),
        Binary(_, left, right) | Compare(_, left, right) | FloatBinary(_, left, right) | FloatCompare(_, left, right) => Vec::from_array(
            [left, right],
        ),
        Select(condition, yes, no) => Vec::from_array([condition, yes, no]),
        Call(_, arguments) => copy_vec(arguments),
    }
}

pub fn successors(term: Terminator) -> Vec[Edge] {
    match term {
        Jump(edge) => Vec::from_array([copy_edge(edge)]),
        Branch(_, yes, no) => Vec::from_array([copy_edge(yes), copy_edge(no)]),
        Return(_) => Vec::new(),
    }
}

fn require_type(function: Function, value: Value, ty: Type) -> Result[(), Error] {
    if function.value_type(value)? != ty {
        return Result::Err(error(ErrorKind::TypeMismatch, f"incorrect type for v{value.slot}"))
    }
    Result::Ok(())
}

fn operation_types(function: Function, operation: Operation) -> Result[Vec[Type], Error] {
    match operation {
        Constant(value) => Result::Ok(Vec::from_array([value.value_type()])),
        Binary(_, left, right) => {
            let ty = require_integer_pair(function, left, right)?;
            Result::Ok(Vec::from_array([ty]))
        },
        Compare(_, left, right) => {
            let _ = require_integer_pair(function, left, right)?;
            Result::Ok(Vec::from_array([Type::Bool]))
        },
        Select(condition, yes, no) => {
            require_type(function, condition, Type::Bool)?;
            let ty = function.value_type(yes)?;
            require_type(function, no, ty)?;
            Result::Ok(Vec::from_array([ty]))
        },
        FloatBinary(_, left, right) | FloatCompare(_, left, right) => {
            require_type(function, left, Type::F64)?;
            require_type(function, right, Type::F64)?;
            let ty = match operation {
                FloatBinary(_, _, _) => Type::F64,
                _ => Type::Bool,
            };
            Result::Ok(Vec::from_array([ty]))
        },
        Convert(conversion, value) => {
            let (input, output) = match conversion {
                SignExtend | ZeroExtend => (Type::I32, Type::I64),
                Truncate => (Type::I64, Type::I32),
            };
            require_type(function, value, input)?;
            Result::Ok(Vec::from_array([output]))
        },
        StackLoad(slot) => Result::Ok(Vec::from_array([function.stack_slot_type(slot)?])),
        StackStore(slot, value) => {
            require_type(function, value, function.stack_slot_type(slot)?)?;
            Result::Ok(Vec::new())
        },
        Call(target, arguments) => {
            let owner = function.module_identity.ok_or(
                error(ErrorKind::WrongFunction, "call requires a module function builder"),
            )?;
            if !ptr_eq(owner, target.owner) {
                return Result::Err(
                    error(ErrorKind::WrongFunction, "call target belongs to another module"),
                )
            }
            let inputs = target.signature().parameter_types();
            if inputs.len() != arguments.len() {
                return Result::Err(
                    error(ErrorKind::TypeMismatch, "call argument count differs from signature"),
                )
            }
            for index in 0..arguments.len() {
                require_type(function, arguments[index], inputs[index])?;
            }
            Result::Ok(target.signature().result_types())
        },
    }
}

impl Operation {
    pub fn effects(self: Operation) -> Effects {
        if let Operation::Binary(op, _, _) = self {
            if op.may_trap() {
                return Effects {
                    reads_memory: false,
                    writes_memory: false,
                    may_trap: true,
                    call: false,
                }
            }
        }
        match self {
            StackLoad(_) => Effects {
                reads_memory: true,
                writes_memory: false,
                may_trap: false,
                call: false,
            },
            StackStore(_, _) => Effects {
                reads_memory: false,
                writes_memory: true,
                may_trap: false,
                call: false,
            },
            Call(_, _) => Effects {
                reads_memory: true,
                writes_memory: true,
                may_trap: true,
                call: true,
            },
            _ => Effects { reads_memory: false, writes_memory: false, may_trap: false, call: false },
        }
    }

    pub fn has_effects(self: Operation) -> bool {
        let effects = self.effects();
        effects.reads_memory || effects.writes_memory || effects.may_trap || effects.call
    }
}

fn require_integer_pair(function: Function, left: Value, right: Value) -> Result[Type, Error] {
    let ty = function.value_type(left)?;
    if ty != Type::I64 && ty != Type::I32 {
        return Result::Err(error(ErrorKind::TypeMismatch, "integer operation requires I32 or I64"))
    }
    require_type(function, right, ty)?;
    Result::Ok(ty)
}

fn check_stack_slot(function: Function, slot: StackSlot) -> Result[(), Error] {
    if !ptr_eq(function.identity, slot.owner) {
        return Result::Err(
            error(ErrorKind::WrongFunction, "stack slot belongs to another function"),
        )
    }
    if slot.slot < 0 || slot.slot >= function.slots.len() {
        return Result::Err(error(ErrorKind::InvalidHandle, "invalid stack slot"))
    }
    Result::Ok(())
}

impl Debug for Operation {
    fn debug(self: Operation) -> string {
        operation_text(self)
    }
}

impl Debug for Instruction {
    fn debug(self: Instruction) -> string {
        value_list(self.results) + " = " + operation_text(self.operation)
    }
}
