package amd64;

use ecosystem::goir as ir;
use module::abi;

pub struct Compiled {
    pub assembly: string,
    pub declaration: string,
    pub frame_bytes: isize,
    pub stack_slots: isize,
}

fn load(lines: Vec[string], value: ir::Value, register: string, base: isize) -> () {
    let offset = base + value.index() * 8;
    lines.push(f"    MOVQ {offset}(SP), {register}");
}

fn save(lines: Vec[string], value: ir::Value, register: string, base: isize) -> () {
    let offset = base + value.index() * 8;
    lines.push(f"    MOVQ {register}, {offset}(SP)");
}

fn binary_opcode(op: ir::BinaryOp) -> string {
    match op {
        Add => "ADDQ",
        Sub => "SUBQ",
        Mul => "IMULQ",
        And => "ANDQ",
        Or => "ORQ",
        Xor => "XORQ",
        Shl => "SHLQ",
        ShrU => "SHRQ",
        ShrS => "SARQ",
    }
}

fn comparison_opcode(cc: ir::IntCC) -> string {
    match cc {
        Equal => "SETEQ",
        NotEqual => "SETNE",
        SignedLess => "SETLT",
        SignedLessEqual => "SETLE",
        UnsignedLess => "SETCS",
        UnsignedLessEqual => "SETLS",
    }
}

fn instruction(
    lines: Vec[string],
    value: ir::Instruction,
    base: isize,
    function: ir::Function,
    locals: isize,
) -> Result[(), ir::Error] {
    match value.operation {
        Constant(datum) => {
            let integer = datum.bits();
            lines.push("    MOVQ $" + integer.to_string() + ", AX");
        },
        Binary(op, left, right) => {
            load(lines, left, "AX", base);
            load(lines, right, "CX", base);
            lines.push("    " + typed_binary_opcode(op, function.value_type(left)?) + " CX, AX");
        },
        Compare(cc, left, right) => {
            load(lines, left, "AX", base);
            load(lines, right, "CX", base);
            lines.push("    " + compare_width(function.value_type(left)?) + " AX, CX");
            lines.push("    " + comparison_opcode(cc) + " AL");
            lines.push("    MOVBQZX AL, AX");
        },
        Select(condition, yes, no) => {
            load(lines, condition, "DX", base);
            load(lines, yes, "AX", base);
            load(lines, no, "CX", base);
            lines.push("    CMPQ DX, $0");
            lines.push("    CMOVQEQ CX, AX");
        },
        FloatBinary(op, left, right) => {
            load(lines, left, "X0", base);
            load(lines, right, "X1", base);
            lines.push("    " + float_opcode(op) + " X1, X0");
            save(lines, value.results[0], "X0", base);
            return Result::Ok(())
        },
        FloatCompare(cc, left, right) => {
            load(lines, left, "X0", base);
            load(lines, right, "X1", base);
            float_compare(lines, cc);
        },
        Convert(op, input) => {
            load(lines, input, "AX", base);
            lines.push("    " + conversion_opcode(op) + " AX, AX");
        },
        StackLoad(slot) => {
            let offset = locals + slot.index() * 8;
            lines.push(f"    MOVQ {offset}(SP), AX");
        },
        StackStore(slot, input) => {
            load(lines, input, "AX", base);
            let offset = locals + slot.index() * 8;
            lines.push(f"    MOVQ AX, {offset}(SP)");
            return Result::Ok(())
        },
        Call(target, arguments) => {
            let plan = abi::amd64_abi0_signature(target.signature())?;
            abi::validate_identifier(target.name())?;
            for position in 0..arguments.len() {
                load(lines, arguments[position], "AX", base);
                let slot = plan.parameters[position];
                let opcode = abi_store_opcode(slot.ty);
                let offset = slot.offset;
                lines.push(f"    {opcode} AX, {offset}(SP)");
            }
            lines.push("    CALL ·" + target.name() + "(SB)");
            for position in 0..value.results.len() {
                let slot = plan.results[position];
                let opcode = abi_load_opcode(slot.ty);
                let offset = slot.offset;
                lines.push(f"    {opcode} {offset}(SP), AX");
                save(lines, value.results[position], "AX", base);
            }
            return Result::Ok(())
        },
    }
    save(lines, value.results[0], "AX", base);
    Result::Ok(())
}

fn transfer(
    lines: Vec[string],
    edge: ir::Edge,
    blocks: Vec[ir::BlockData],
    scratch: isize,
    base: isize,
) -> () {
    for index in 0..edge.arguments.len() {
        load(lines, edge.arguments[index], "AX", base);
        let offset = scratch + index * 8;
        lines.push(f"    MOVQ AX, {offset}(SP)");
    }
    let parameters = blocks[edge.target.index()].parameters;
    for index in 0..parameters.len() {
        let offset = scratch + index * 8;
        lines.push(f"    MOVQ {offset}(SP), AX");
        save(lines, parameters[index], "AX", base);
    }
    let target = edge.target.index();
    lines.push(f"    JMP block{target}");
}

pub fn emit_stack(function: ir::Function) -> Result[Compiled, ir::Error] {
    emit_stack_function(function, true)
}

fn emit_stack_function(function: ir::Function, header: bool) -> Result[Compiled, ir::Error] {
    ir::verify(function)?;
    let declaration = abi::declaration(function)?;
    let plan = abi::amd64_abi0(function)?;
    let blocks = function.blocks();
    let mut temporary_slots = 0;
    for block in blocks {
        if block.id.index() != 0 && block.parameters.len() > temporary_slots {
            temporary_slots = block.parameters.len();
        }
    }
    let base = outgoing_bytes(function)?;
    let stack_slots = base / 8 + function.value_count() + temporary_slots
        + function.stack_slots().len();
    let locals = base + (function.value_count() + temporary_slots) * 8;
    let frame_bytes = stack_slots * 8;
    if frame_bytes > 32768 {
        return Result::Err(
            ir::error(ir::ErrorKind::LimitExceeded, "amd64 stack frame exceeds 32768 bytes"),
        )
    }
    let name = function.name();
    let argument_bytes = plan.argument_bytes;
    let lines = Vec::new();
    if header {
        lines.push("#include \"funcdata.h\"");
        lines.push("");
    }
    lines.push(f"TEXT ·{name}(SB), $" + frame_bytes.to_string() + f"-{argument_bytes}");
    lines.push("    NO_LOCAL_POINTERS");
    initialize_slots(lines, function, locals);
    for index in 0..plan.parameters.len() {
        let slot = plan.parameters[index];
        let offset = slot.offset;
        let opcode = abi_load_opcode(slot.ty);
        lines.push(f"    {opcode} p{index}+{offset}(FP), AX");
        save(lines, blocks[0].parameters[index], "AX", base);
    }
    for block in blocks {
        let index = block.id.index();
        lines.push(f"block{index}:");
        for value in block.instructions {
            instruction(lines, value, base, function, locals)?;
        }
        let term = block.terminator.ok_or(
            ir::error(ir::ErrorKind::ControlFlow, "missing terminator"),
        )?;
        match term {
            Return(values) => {
                for position in 0..values.len() {
                    load(lines, values[position], "AX", base);
                    let slot = plan.results[position];
                    let offset = slot.offset;
                    let opcode = abi_store_opcode(slot.ty);
                    lines.push(f"    {opcode} AX, r{position}+{offset}(FP)");
                }
                lines.push("    RET");
            },
            Jump(edge) => transfer(lines, edge, blocks, base + function.value_count() * 8, base),
            Branch(condition, yes, no) => {
                load(lines, condition, "AX", base);
                lines.push("    CMPQ AX, $0");
                lines.push(f"    JNE edge_yes{index}");
                transfer(lines, no, blocks, base + function.value_count() * 8, base);
                lines.push(f"edge_yes{index}:");
                transfer(lines, yes, blocks, base + function.value_count() * 8, base);
            },
        }
    }
    Result::Ok(
        Compiled { assembly: lines.join("\n") + "\n", declaration, frame_bytes, stack_slots },
    )
}

pub struct Package {
    pub assembly: string,
    pub declarations: string,
}

pub fn emit_stack_package(name: string, functions: Vec[ir::Function]) -> Result[Package, ir::Error] {
    abi::validate_identifier(name)?;
    if functions.is_empty() || functions.len() > 256 {
        return Result::Err(
            ir::error(ir::ErrorKind::LimitExceeded, "package requires 1..256 functions"),
        )
    }
    let symbols = Vec::new();
    let assembly = Vec::from_array(["#include \"funcdata.h\"\n"]);
    let declarations = Vec::from_array(["package " + name + "\n"]);
    for function in functions {
        if symbols.contains(function.name()) {
            return Result::Err(
                ir::error(ir::ErrorKind::InvalidArgument, "duplicate function symbol"),
            )
        }
        symbols.push(function.name());
        let compiled = emit_stack_function(function, false)?;
        assembly.push(compiled.assembly);
        declarations.push(compiled.declaration);
    }
    Result::Ok(Package { assembly: assembly.join("\n"), declarations: declarations.join("\n") })
}

fn outgoing_bytes(function: ir::Function) -> Result[isize, ir::Error] {
    let mut size = 0;
    for block in function.blocks() {
        for instruction in block.instructions {
            if let ir::Operation::Call(target, _) = instruction.operation {
                let plan = abi::amd64_abi0_signature(target.signature())?;
                let bytes = (plan.argument_bytes + 7) / 8 * 8;
                if bytes > size {
                    size = bytes;
                }
            }
        }
    }
    Result::Ok(size)
}

pub fn emit_stack_module(name: string, module: ir::Module) -> Result[Package, ir::Error] {
    ir::verify_module(module)?;
    for target in module.references() {
        abi::validate_identifier(target.name())?;
        if Vec::from_array(["init", "main", "int64", "int32", "float64", "bool"]).contains(
            target.name(),
        ) {
            return Result::Err(
                ir::error(
                    ir::ErrorKind::InvalidArgument,
                    "function name conflicts with generated Go declarations",
                ),
            )
        }
    }
    emit_stack_package(name, module.functions())
}

fn typed_binary_opcode(op: ir::BinaryOp, ty: ir::Type) -> string {
    if ty != ir::Type::I32 {
        return binary_opcode(op)
    }
    match op {
        Add => "ADDL",
        Sub => "SUBL",
        Mul => "IMULL",
        And => "ANDL",
        Or => "ORL",
        Xor => "XORL",
        Shl => "SHLL",
        ShrU => "SHRL",
        ShrS => "SARL",
    }
}

fn compare_width(ty: ir::Type) -> string {
    if ty == ir::Type::I32 {
        "CMPL"
    } else {
        "CMPQ"
    }
}

fn conversion_opcode(op: ir::IntConversion) -> string {
    match op {
        SignExtend => "MOVLQSX",
        ZeroExtend | Truncate => "MOVL",
    }
}

fn float_opcode(op: ir::FloatOp) -> string {
    match op {
        Add => "ADDSD",
        Sub => "SUBSD",
        Mul => "MULSD",
        Div => "DIVSD",
    }
}

fn abi_load_opcode(ty: ir::Type) -> string {
    match ty {
        I64 | F64 => "MOVQ",
        I32 => "MOVL",
        Bool => "MOVBQZX",
    }
}

fn abi_store_opcode(ty: ir::Type) -> string {
    match ty {
        I64 | F64 => "MOVQ",
        I32 => "MOVL",
        Bool => "MOVB",
    }
}

fn float_compare(lines: Vec[string], cc: ir::FloatCC) -> () {
    lines.push("    UCOMISD X1, X0");
    let opcode = match cc {
        Equal => "SETEQ",
        NotEqual => "SETNE",
        Less => "SETCS",
        LessEqual => "SETLS",
    };
    lines.push("    " + opcode + " AL");
    if cc == ir::FloatCC::NotEqual {
        lines.push("    SETPS DL");
        lines.push("    ORB DL, AL");
    } else {
        lines.push("    SETPC DL");
        lines.push("    ANDB DL, AL");
    }
    lines.push("    MOVBQZX AL, AX");
}

fn initialize_slots(lines: Vec[string], function: ir::Function, base: isize) -> () {
    for slot in function.stack_slots() {
        let offset = base + slot.index() * 8;
        lines.push(f"    MOVQ $0, {offset}(SP)");
    }
}
