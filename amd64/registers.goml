package amd64;

use ecosystem::goir as ir;
use module::abi;
use module::mach;
use module::regalloc;

fn physical(index: isize) -> string {
    Vec::from_array(["BX", "SI", "DI", "R8", "R9", "R10", "R11"])[index]
}

fn place_at(location: regalloc::Location, base: isize) -> string {
    match location {
        Register(index) => physical(index),
        Fixed(register) => match register {
            AX => "AX",
            CX => "CX",
            DX => "DX",
        },
        Stack(index) => (base + index * 8).to_string() + "(SP)",
    }
}

fn move_operand(lines: Vec[string], source: string, destination: string) -> () {
    if source != destination {
        lines.push("    MOVQ " + source + ", " + destination);
    }
}

fn register_location(location: regalloc::Location) -> bool {
    match location {
        Register(_) | Fixed(_) => true,
        Stack(_) => false,
    }
}

fn emit_edits(lines: Vec[string], edits: Vec[regalloc::Edit], base: isize) -> Result[(), ir::Error] {
    for edit in edits {
        if edit.source == edit.destination {
            continue;
        }
        if !register_location(edit.source) && !register_location(edit.destination) {
            return Result::Err(
                ir::error(
                    ir::ErrorKind::InvalidState,
                    "allocated memory copy requires an explicit scratch edit",
                ),
            )
        }
        move_operand(lines, place_at(edit.source, base), place_at(edit.destination, base));
    }
    Result::Ok(())
}

fn allocated_instruction(
    lines: Vec[string],
    instruction: regalloc::AllocatedInstruction,
    base: isize,
) -> Result[(), ir::Error] {
    emit_edits(lines, instruction.before, base)?;
    let operands = instruction.operands;
    match instruction.instruction {
        Immediate { value, .. } => {
            lines.push(
                "    MOVQ $" + value.to_string() + ", " + place_at(operands[0].location, base),
            );
        },
        Binary { op, .. } => {
            lines.push(
                "    " + binary_opcode(op) + " " + place_at(operands[1].location, base) + ", "
                    + place_at(operands[2].location, base),
            );
        },
        Compare { cc, .. } => {
            lines.push(
                "    CMPQ " + place_at(operands[0].location, base) + ", "
                    + place_at(operands[1].location, base),
            );
            lines.push("    " + comparison_opcode(cc) + " AL");
            lines.push("    MOVBQZX AL, AX");
        },
        Select { .. } => {
            lines.push("    CMPQ " + place_at(operands[0].location, base) + ", $0");
            lines.push(
                "    CMOVQEQ " + place_at(operands[2].location, base) + ", "
                    + place_at(operands[3].location, base),
            );
        },
        Call { target, arguments, results } => {
            abi::validate_identifier(target.name())?;
            let plan = abi::amd64_abi0_signature(target.signature())?;
            for index in 0..arguments.len() {
                let location = operands[index].location;
                let source = if register_location(location) {
                    place_at(location, base)
                } else {
                    "AX"
                };
                move_operand(lines, place_at(location, base), source);
                let slot = plan.parameters[index];
                let opcode = match slot.ty {
                    I64 => "MOVQ",
                    Bool => "MOVB",
                };
                let offset = slot.offset;
                lines.push(f"    {opcode} " + source + f", {offset}(SP)");
            }
            lines.push("    CALL ·" + target.name() + "(SB)");
            for index in 0..results.len() {
                let location = operands[arguments.len() + index].location;
                let destination = if register_location(location) {
                    place_at(location, base)
                } else {
                    "AX"
                };
                let slot = plan.results[index];
                let opcode = match slot.ty {
                    I64 => "MOVQ",
                    Bool => "MOVBQZX",
                };
                let offset = slot.offset;
                lines.push(f"    {opcode} {offset}(SP), " + destination);
                move_operand(lines, destination, place_at(location, base));
            }
        },
    }
    emit_edits(lines, instruction.after, base)
}

fn emit_allocated_edge(lines: Vec[string], edge: regalloc::AllocatedEdge, base: isize) -> Result[
    (),
    ir::Error,
] {
    emit_edits(lines, edge.edits, base)?;
    let target = edge.edge.target;
    lines.push(f"    JMP block{target}");
    Result::Ok(())
}

pub fn emit(function: ir::Function) -> Result[Compiled, ir::Error] {
    emit_with_options(function, regalloc::Options::standard())
}

pub fn emit_with_options(function: ir::Function, options: regalloc::Options) -> Result[
    Compiled,
    ir::Error,
] {
    if options.registers > 7 {
        return Result::Err(
            ir::error(
                ir::ErrorKind::Unsupported,
                "amd64 allocator supports at most seven registers",
            ),
        )
    }
    emit_allocation(regalloc::allocate_with_options(mach::lower(function)?, options)?)
}

pub fn emit_allocation(allocation: regalloc::Allocation) -> Result[Compiled, ir::Error] {
    emit_allocated_function(allocation, true)
}

fn emit_allocated_function(allocation: regalloc::Allocation, header: bool) -> Result[
    Compiled,
    ir::Error,
] {
    regalloc::verify(allocation)?;
    if allocation.register_count() > 7 {
        return Result::Err(
            ir::error(
                ir::ErrorKind::Unsupported,
                "amd64 allocator supports at most seven registers",
            ),
        )
    }
    let function = allocation.function().source();
    let declaration = abi::declaration(function)?;
    let plan = abi::amd64_abi0(function)?;
    let base = outgoing_bytes(function)?;
    let stack_slots = base / 8 + allocation.stack_slots();
    let frame_bytes = stack_slots * 8;
    if frame_bytes > 32768 {
        return Result::Err(
            ir::error(ir::ErrorKind::LimitExceeded, "amd64 stack frame exceeds 32768 bytes"),
        )
    }
    let name = function.name();
    let argument_bytes = plan.argument_bytes;
    let lines = Vec::new();
    if header {
        lines.push("#include \"funcdata.h\"");
        lines.push("");
    }
    lines.push(f"TEXT ·{name}(SB), $" + frame_bytes.to_string() + f"-{argument_bytes}");
    lines.push("    NO_LOCAL_POINTERS");
    let blocks = allocation.function().blocks();
    let allocated = allocation.blocks();
    for index in 0..plan.parameters.len() {
        let slot = plan.parameters[index];
        let offset = slot.offset;
        let opcode = match slot.ty {
            I64 => "MOVQ",
            Bool => "MOVBQZX",
        };
        let destination = allocation.location(blocks[0].parameters[index])?;
        let register = if register_location(destination) {
            place_at(destination, base)
        } else {
            "AX"
        };
        lines.push(f"    {opcode} p{index}+{offset}(FP), " + register);
        move_operand(lines, register, place_at(destination, base));
    }
    for block in allocated {
        let index = block.index;
        lines.push(f"block{index}:");
        for instruction in block.instructions {
            allocated_instruction(lines, instruction, base)?;
        }
        match blocks[index].terminator {
            Return(values) => {
                for position in 0..values.len() {
                    let source = block.terminator_operands[position].location;
                    let register = if register_location(source) {
                        place_at(source, base)
                    } else {
                        "AX"
                    };
                    move_operand(lines, place_at(source, base), register);
                    let slot = plan.results[position];
                    let offset = slot.offset;
                    let opcode = match slot.ty {
                        I64 => "MOVQ",
                        Bool => "MOVB",
                    };
                    lines.push(f"    {opcode} " + register + f", r{position}+{offset}(FP)");
                }
                lines.push("    RET");
            },
            Jump(_) => emit_allocated_edge(lines, block.edges[0], base)?,
            Branch { .. } => {
                lines.push(
                    "    CMPQ " + place_at(block.terminator_operands[0].location, base) + ", $0",
                );
                lines.push(f"    JNE edge_yes{index}");
                emit_allocated_edge(lines, block.edges[1], base)?;
                lines.push(f"edge_yes{index}:");
                emit_allocated_edge(lines, block.edges[0], base)?;
            },
        }
    }
    Result::Ok(
        Compiled { assembly: lines.join("\n") + "\n", declaration, frame_bytes, stack_slots },
    )
}

pub fn emit_package(name: string, functions: Vec[ir::Function]) -> Result[Package, ir::Error] {
    emit_package_with_options(name, functions, regalloc::Options::standard())
}

pub fn emit_package_with_options(
    name: string,
    functions: Vec[ir::Function],
    options: regalloc::Options,
) -> Result[Package, ir::Error] {
    abi::validate_identifier(name)?;
    if functions.is_empty() || functions.len() > 256 {
        return Result::Err(
            ir::error(ir::ErrorKind::LimitExceeded, "package requires 1..256 functions"),
        )
    }
    if options.registers > 7 {
        return Result::Err(
            ir::error(
                ir::ErrorKind::Unsupported,
                "amd64 allocator supports at most seven registers",
            ),
        )
    }
    let symbols = Vec::new();
    let assembly = Vec::from_array(["#include \"funcdata.h\"\n"]);
    let declarations = Vec::from_array(["package " + name + "\n"]);
    for function in functions {
        if symbols.contains(function.name()) {
            return Result::Err(
                ir::error(ir::ErrorKind::InvalidArgument, "duplicate function symbol"),
            )
        }
        symbols.push(function.name());
        let compiled = emit_allocated_function(
            regalloc::allocate_with_options(mach::lower(function)?, options)?,
            false,
        )?;
        assembly.push(compiled.assembly);
        declarations.push(compiled.declaration);
    }
    Result::Ok(Package { assembly: assembly.join("\n"), declarations: declarations.join("\n") })
}

pub fn emit_module(name: string, module: ir::Module) -> Result[Package, ir::Error] {
    emit_module_with_options(name, module, regalloc::Options::standard())
}

pub fn emit_module_with_options(name: string, module: ir::Module, options: regalloc::Options) -> Result[
    Package,
    ir::Error,
] {
    ir::verify_module(module)?;
    for target in module.references() {
        abi::validate_identifier(target.name())?;
        if Vec::from_array(["init", "main", "int64", "bool"]).contains(target.name()) {
            return Result::Err(
                ir::error(
                    ir::ErrorKind::InvalidArgument,
                    "function name conflicts with generated Go declarations",
                ),
            )
        }
    }
    emit_package_with_options(name, module.functions(), options)
}
