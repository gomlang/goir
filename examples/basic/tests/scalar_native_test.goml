package tests;

use ecosystem::goir as ir;
use ecosystem::goir::amd64;
use ecosystem::goir::regalloc;
use ecosystem::goir::opt;
use std::crypto::hash;
use std::crypto::rand;
use std::fs;
use std::path;
use std::testing;

fn native_scalar_function(name: string, ty: ir::Type, shift: bool) -> ir::Function {
    let operations = if shift {
        Vec::from_array(
            [ir::BinaryOp::ShlChecked, ir::BinaryOp::ShrUChecked, ir::BinaryOp::ShrSChecked],
        )
    } else {
        Vec::from_array(
            [ir::BinaryOp::DivS, ir::BinaryOp::RemS, ir::BinaryOp::DivU, ir::BinaryOp::RemU],
        )
    };
    let outputs = Vec::new();
    for _ in 0..operations.len() + 2 {
        outputs.push(ty);
    }
    let b = testing::expect_ok(
        ir::Builder::new(name, Vec::from_array([ty, ty]), outputs),
        "scalar builder",
    );
    let p = testing::expect_ok(b.parameters(b.entry()), "parameters");
    let values = Vec::new();
    for op in operations {
        values.push(testing::expect_ok(b.binary(op, p[0], p[1]), "scalar operation"));
    }
    values.push(p[0]);
    values.push(p[1]);
    testing::assert_ok(b.ret(values));
    testing::expect_ok(b.finish(), "scalar function")
}

fn native_fold_function(name: string, ty: ir::Type) -> ir::Function {
    let b = testing::expect_ok(
        ir::Builder::new(name, Vec::from_array([ty, ty]), Vec::from_array([ty])),
        "fold builder",
    );
    let p = testing::expect_ok(b.parameters(b.entry()), "parameters");
    let slot = testing::expect_ok(b.stack_slot(ty), "slot");
    testing::assert_ok(b.stack_store(slot, p[1]));
    let loaded = testing::expect_ok(b.stack_load(slot), "load");
    let result = testing::expect_ok(
        if ty == ir::Type::F64 {
            b.fbinary(ir::FloatOp::Sub, p[0], loaded)
        } else {
            b.binary(ir::BinaryOp::Sub, p[0], loaded)
        },
        "fold operation",
    );
    testing::assert_ok(b.ret(Vec::from_array([result])));
    testing::expect_ok(b.finish(), "fold function")
}

fn native_identity_i32() -> ir::Function {
    let b = testing::expect_ok(
        ir::Builder::new(
            "Identity32",
            Vec::from_array([ir::Type::I32]),
            Vec::from_array([ir::Type::I32, ir::Type::I32, ir::Type::I32]),
        ),
        "identity builder",
    );
    let input = testing::expect_ok(b.parameters(b.entry()), "input")[0];
    let zero = testing::expect_ok(b.i32const(0), "zero");
    let one = testing::expect_ok(b.i32const(1), "one");
    let mask = testing::expect_ok(b.i32const(-1), "mask");
    let negative_width = testing::expect_ok(b.i32const(-32), "negative width");
    let mut value = input;
    for (op, constant) in Vec::from_array(
        [
            (ir::BinaryOp::Add, zero),
            (ir::BinaryOp::Sub, zero),
            (ir::BinaryOp::Mul, one),
            (ir::BinaryOp::And, mask),
            (ir::BinaryOp::Or, zero),
            (ir::BinaryOp::Xor, zero),
            (ir::BinaryOp::Shl, negative_width),
            (ir::BinaryOp::ShrU, negative_width),
            (ir::BinaryOp::ShrS, negative_width),
        ],
    ) {
        value = testing::expect_ok(b.binary(op, value, constant), "identity");
    }
    let equal = testing::expect_ok(
        b.icmp(ir::IntCC::UnsignedLessEqual, input, input),
        "self comparison",
    );
    value = testing::expect_ok(b.select(equal, value, zero), "select");
    let erased = testing::expect_ok(b.binary(ir::BinaryOp::Mul, input, zero), "zero multiply");
    let ones = testing::expect_ok(b.binary(ir::BinaryOp::Or, input, mask), "all ones");
    testing::assert_ok(b.ret(Vec::from_array([value, erased, ones])));
    testing::expect_ok(b.finish(), "identity function")
}

fn native_rotate_function(name: string, ty: ir::Type) -> ir::Function {
    let b = testing::expect_ok(
        ir::Builder::new(name, Vec::from_array([ty, ty]), Vec::from_array([ty, ty, ty, ty, ty, ty])),
        "rotate builder",
    );
    let p = testing::expect_ok(b.parameters(b.entry()), "parameters");
    let constant = testing::expect_ok(
        b.ins(ir::Operation::Constant(ir::datum_from_bits(ty, -1))),
        "count",
    );
    let value = testing::expect_ok(
        b.ins(ir::Operation::Constant(ir::datum_from_bits(ty, 1))),
        "value",
    );
    let out = Vec::new();
    for op in Vec::from_array([ir::BinaryOp::Rotl, ir::BinaryOp::Rotr]) {
        out.push(testing::expect_ok(b.binary(op, p[0], p[1]), "variable rotate"));
        out.push(testing::expect_ok(b.binary(op, p[0], constant), "immediate rotate"));
        out.push(testing::expect_ok(b.binary(op, value, constant), "constant rotate"));
    }
    testing::assert_ok(b.ret(out));
    testing::expect_ok(b.finish(), "rotate function")
}

fn native_bitcount_function(name: string, ty: ir::Type) -> ir::Function {
    let b = testing::expect_ok(
        ir::Builder::new(name, Vec::from_array([ty]), Vec::from_array([ty, ty, ty, ty, ty, ty, ty])),
        "count builder",
    );
    let input = testing::expect_ok(b.parameters(b.entry()), "parameters")[0];
    let zero = testing::expect_ok(
        b.ins(ir::Operation::Constant(ir::datum_from_bits(ty, 0))),
        "zero",
    );
    let out = Vec::new();
    for op in Vec::from_array([ir::UnaryOp::Clz, ir::UnaryOp::Ctz, ir::UnaryOp::Popcnt]) {
        out.push(testing::expect_ok(b.unary(op, input), "variable count"));
        out.push(testing::expect_ok(b.unary(op, zero), "constant count"));
    }
    out.push(input);
    testing::assert_ok(b.ret(out));
    testing::expect_ok(b.finish(), "count function")
}

fn native_bswap_function(name: string, ty: ir::Type) -> ir::Function {
    let b = testing::expect_ok(
        ir::Builder::new(name, Vec::from_array([ty]), Vec::from_array([ty, ty, ty, ty])),
        "bswap builder",
    );
    let input = testing::expect_ok(b.parameters(b.entry()), "parameters")[0];
    let constant = testing::expect_ok(
        b.ins(ir::Operation::Constant(ir::datum_from_bits(ty, 128))),
        "constant",
    );
    let swapped = testing::expect_ok(b.unary(ir::UnaryOp::Bswap, input), "bswap");
    let twice = testing::expect_ok(b.unary(ir::UnaryOp::Bswap, swapped), "bswap twice");
    let folded = testing::expect_ok(b.unary(ir::UnaryOp::Bswap, constant), "constant bswap");
    testing::assert_ok(b.ret(Vec::from_array([swapped, twice, folded, input])));
    testing::expect_ok(b.finish(), "bswap function")
}

fn native_minmax_function(name: string, ty: ir::Type) -> ir::Function {
    let outputs = Vec::new();
    for _ in 0..14 {
        outputs.push(ty);
    }
    let b = testing::expect_ok(
        ir::Builder::new(name, Vec::from_array([ty, ty]), outputs),
        "minmax builder",
    );
    let p = testing::expect_ok(b.parameters(b.entry()), "parameters");
    let constant = testing::expect_ok(
        b.ins(ir::Operation::Constant(ir::datum_from_bits(ty, 17))),
        "constant",
    );
    let out = Vec::new();
    for op in Vec::from_array(
        [ir::BinaryOp::Smin, ir::BinaryOp::Smax, ir::BinaryOp::Umin, ir::BinaryOp::Umax],
    ) {
        out.push(testing::expect_ok(b.binary(op, p[0], p[1]), "variable minmax"));
        out.push(testing::expect_ok(b.binary(op, p[0], constant), "constant right minmax"));
        out.push(testing::expect_ok(b.binary(op, constant, p[0]), "constant left minmax"));
    }
    out.push(p[0]);
    out.push(p[1]);
    testing::assert_ok(b.ret(out));
    testing::expect_ok(b.finish(), "minmax function")
}

#[test]
fn native_division_checked_shifts_and_folded_loads_match_go_reference() -> () {
    let directory = path::join(
        "_artifact",
        "goir-scalar-" + hash::sha256(testing::expect_ok(rand::bytes(16), "unique artifact")),
    );
    testing::assert_ok(fs::create_dir_all(directory));
    let source = Vec::from_array(
        [
            native_identity_i32(),
            native_bswap_function("Bswap32", ir::Type::I32),
            native_bswap_function("Bswap64", ir::Type::I64),
            native_minmax_function("Minmax32", ir::Type::I32),
            native_minmax_function("Minmax64", ir::Type::I64),
            native_bitcount_function("Count32", ir::Type::I32),
            native_bitcount_function("Count64", ir::Type::I64),
            native_rotate_function("Rotate32", ir::Type::I32),
            native_rotate_function("Rotate64", ir::Type::I64),
            native_scalar_function("Div64", ir::Type::I64, false),
            native_scalar_function("Div32", ir::Type::I32, false),
            native_scalar_function("Shift64", ir::Type::I64, true),
            native_scalar_function("Shift32", ir::Type::I32, true),
            native_fold_function("Fold64", ir::Type::I64),
            native_fold_function("Fold32", ir::Type::I32),
            native_fold_function("FoldFloat", ir::Type::F64),
        ],
    );
    let simplified = Vec::new();
    for function in source {
        simplified.push(testing::expect_ok(opt::simplify(function), "simplify scalar"));
    }
    for (name, functions, stack, registers, linear) in Vec::from_array(
        [
            ("generated", source, false, 7, false),
            ("baseline", source, true, 7, false),
            ("constrained", source, false, 1, false),
            ("spilled", source, false, 0, false),
            ("optimized", simplified, false, 7, false),
            ("optstack", simplified, true, 7, false),
            ("linear", source, false, 7, true),
        ],
    ) {
        let options = regalloc::Options { registers, ..regalloc::Options::standard() };
        let output = if linear {
            let assembly = Vec::from_array(["#include \"funcdata.h\"\n"]);
            let declarations = Vec::from_array(["package " + name + "\n"]);
            let context = amd64::CompilerContext::new();
            for function in functions {
                let compiled = testing::expect_ok(
                    context.compile_with_algorithm(
                        function,
                        false,
                        options,
                        regalloc::Algorithm::LinearScan,
                    ),
                    "linear compilation",
                ).compiled;
                assembly.push(compiled.assembly.replace("#include \"funcdata.h\"\n", ""));
                declarations.push(compiled.declaration);
            }
            amd64::Package { assembly: assembly.join("\n"), declarations: declarations.join("\n") }
        } else {
            testing::expect_ok(
                if stack {
                    amd64::emit_stack_package(name, functions)
                } else {
                    amd64::emit_package_with_algorithm(
                        name,
                        functions,
                        options,
                        regalloc::Algorithm::Global,
                    )
                },
                "scalar package",
            )
        };
        let destination = if name == "generated" {
            directory
        } else {
            path::join(directory, name)
        };
        testing::assert_ok(fs::create_dir_all(destination));
        testing::assert_ok(
            fs::write_file_structured(path::join(destination, "generated.go"), output.declarations),
        );
        testing::assert_ok(
            fs::write_file_structured(path::join(destination, "generated_amd64.s"), output.assembly),
        );
    }
    testing::assert_ok(
        fs::write_file_structured(
            path::join(directory, "go.mod"),
            "module goir-scalar-test\n\ngo 1.26.0\n",
        ),
    );
    let prefix = if fs::is_dir("examples/basic") {
        "examples/basic/"
    } else {
        ""
    };
    let reference = testing::expect_ok(
        fs::read_file_structured(prefix + "tests/data/scalar_reference_test.go"),
        "Go reference",
    );
    testing::assert_ok(
        fs::write_file_structured(path::join(directory, "scalar_test.go"), reference),
    );
    let _ = run_go(directory, Vec::from_array(["vet", "./..."]));
    let output = run_go(
        directory,
        Vec::from_array(["test", "-count=1", "-timeout=60s", "-v", "./..."]),
    );
    testing::assert(output.contains("PASS"));
    testing::assert_ok(fs::write_file_structured("_artifact/scalar-native.txt", output));
    testing::assert_ok(fs::remove_dir_all(directory));
}
