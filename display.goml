package goir;

impl Type {
    pub fn name(self: Type) -> string {
        match self {
            I64 => "i64",
            I32 => "i32",
            F64 => "f64",
            Bool => "bool",
        }
    }
}

impl BinaryOp {
    pub fn name(self: BinaryOp) -> string {
        match self {
            Add => "iadd",
            Sub => "isub",
            Mul => "imul",
            And => "band",
            Or => "bor",
            Xor => "bxor",
            Shl => "ishl",
            ShrU => "ushr",
            ShrS => "sshr",
            DivS => "sdiv",
            DivU => "udiv",
            RemS => "srem",
            RemU => "urem",
            ShlChecked => "ishl_checked",
            ShrUChecked => "ushr_checked",
            ShrSChecked => "sshr_checked",
        }
    }
}

impl IntCC {
    pub fn name(self: IntCC) -> string {
        match self {
            Equal => "eq",
            NotEqual => "ne",
            SignedLess => "slt",
            SignedLessEqual => "sle",
            UnsignedLess => "ult",
            UnsignedLessEqual => "ule",
        }
    }
}

fn value_list(values: Vec[Value]) -> string {
    let items = Vec::new();
    for value in values {
        items.push(f"v{value.slot}");
    }
    items.join(", ")
}

fn edge_text(edge: Edge) -> string {
    f"block{edge.target.slot}(" + value_list(edge.arguments) + ")"
}

fn operation_text(operation: Operation) -> string {
    match operation {
        Constant(Datum::I64(value)) => f"iconst {value}",
        Constant(Datum::I32(value)) => f"i32const {value}",
        Constant(Datum::F64(value)) => f"fconst_bits {float64_to_bits(value)}",
        Constant(Datum::Bool(value)) => f"bconst {value}",
        Binary(op, left, right) => op.name() + f" v{left.slot}, v{right.slot}",
        Compare(cc, left, right) => "icmp " + cc.name() + f" v{left.slot}, v{right.slot}",
        Select(condition, yes, no) => f"select v{condition.slot}, v{yes.slot}, v{no.slot}",
        FloatBinary(op, left, right) => op.name() + f" v{left.slot}, v{right.slot}",
        FloatCompare(cc, left, right) => "fcmp " + cc.name() + f" v{left.slot}, v{right.slot}",
        Convert(conversion, value) => conversion.name() + f" v{value.slot}",
        StackLoad(slot) => f"stack_load slot{slot.slot}",
        StackStore(slot, value) => f"stack_store slot{slot.slot}, v{value.slot}",
        Call(target, arguments) => "call " + target.name() + "(" + value_list(arguments) + ")",
    }
}

pub fn display(function: Function) -> Result[string, Error] {
    verify(function)?;
    let inputs = Vec::new();
    for ty in function.inputs {
        inputs.push(ty.name());
    }
    let outputs = Vec::new();
    for ty in function.outputs {
        outputs.push(ty.name());
    }
    let lines = Vec::from_array(
        [
            "function " + function.name_value + "(" + inputs.join(", ") + ") -> ("
                + outputs.join(", ")
                + ") {",
        ],
    );
    for index in 0..function.slots.len() {
        lines.push(f"    slot{index}: " + function.slots[index].name());
    }
    for block in function.body {
        let parameters = Vec::new();
        for value in block.parameters {
            parameters.push(f"v{value.slot}: " + function.value_type(value)?.name());
        }
        lines.push(f"block{block.id.slot}(" + parameters.join(", ") + "):");
        for instruction in block.instructions {
            let results = Vec::new();
            for result in instruction.results {
                results.push(f"v{result.slot}: " + function.value_type(result)?.name());
            }
            let prefix = if results.is_empty() {
                ""
            } else {
                results.join(", ") + " = "
            };
            lines.push("    " + prefix + operation_text(instruction.operation));
        }
        let term = block.terminator.ok_or(error(ErrorKind::ControlFlow, "missing terminator"))?;
        lines.push(
            "    "
                + match term {
                    Jump(edge) => "jump " + edge_text(edge),
                    Branch(condition, yes, no) => f"brif v{condition.slot}, " + edge_text(yes)
                        + ", "
                        + edge_text(no),
                    Return(values) => "return " + value_list(values),
                },
        );
    }
    lines.push("}");
    Result::Ok(lines.join("\n") + "\n")
}

impl FloatOp {
    pub fn name(self: FloatOp) -> string {
        match self {
            Add => "fadd",
            Sub => "fsub",
            Mul => "fmul",
            Div => "fdiv",
        }
    }
}

impl FloatCC {
    pub fn name(self: FloatCC) -> string {
        match self {
            Equal => "eq",
            NotEqual => "ne",
            Less => "lt",
            LessEqual => "le",
        }
    }
}

impl IntConversion {
    pub fn name(self: IntConversion) -> string {
        match self {
            SignExtend => "sextend",
            ZeroExtend => "uextend",
            Truncate => "ireduce",
        }
    }
}
