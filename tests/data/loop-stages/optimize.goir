module {
declare Countdown(i64) -> (i64)
function Countdown(i64) -> (i64) {
block0(v0: i64):
    v1: i64 = iconst 0
    v2: i64 = iconst 1
    jump block1(v0, v1)
block1(v3: i64, v4: i64):
    v5: bool = icmp slt v1, v3
    v6: i64 = isub v3, v2
    v7: i64 = iadd v4, v3
    brif v5, block1(v6, v7), block2(v4)
block2(v8: i64):
    return v8
}

}
