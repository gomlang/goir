module {
declare Countdown(i64) -> (i64)
function Countdown(i64) -> (i64) {
block0(v0: i64):
    v4: i64 = iconst 0
    v5: i64 = iconst 1
    jump block1(v0, v4)
block1(v1: i64, v2: i64):
    v6: bool = icmp slt v4, v1
    v7: i64 = isub v1, v5
    v8: i64 = iadd v2, v1
    brif v6, block1(v7, v8), block2(v2)
block2(v3: i64):
    return v3
}

}
