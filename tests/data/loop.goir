function Countdown(i64) -> (i64) {
block0(v0: i64):
    v3: i64 = iconst 0
    v4: i64 = iconst 1
    jump block1(v0, v3)
block1(v1: i64, v2: i64):
    v5: bool = icmp slt v3, v1
    v6: i64 = isub v1, v4
    v7: i64 = iadd v2, v1
    brif v5, block1(v6, v7), block2(v2)
block2(v8: i64):
    return v8
}
