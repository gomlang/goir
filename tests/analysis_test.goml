package tests;

use ecosystem::goir as ir;
use ecosystem::goir::analysis;
use std::testing;

#[test]
fn analysis_handles_nested_loops_unreachable_nodes_and_parallel_edges() -> () {
    let edges = Vec::from_array(
        [
            Vec::from_array([1]),
            Vec::from_array([2, 5]),
            Vec::from_array([3, 4]),
            Vec::from_array([2, 2]),
            Vec::from_array([1]),
            Vec::new(),
            Vec::from_array([6]),
        ],
    );
    let graph = testing::expect_ok(analysis::Graph::new(edges, Ref::new(100000)), "graph");
    testing::assert(graph.block_weights() == Vec::from_array([1, 8, 64, 64, 8, 1, 1]));
    testing::assert(testing::expect_ok(graph.dominates(1, 3), "outer dominates"));
    testing::assert(!testing::expect_ok(graph.dominates(3, 2), "backedge is not dominance"));
    testing::assert(!testing::expect_ok(graph.is_reachable(6), "unreachable"));
    testing::assert_eq(graph.loops().len(), 2);
    testing::assert_eq(graph.loops()[1].depth, 2);
    testing::assert(!testing::expect_ok(graph.dominates(6, 6), "unreachable dominance"));
    let predecessors = testing::expect_ok(graph.predecessors(2), "predecessors");
    predecessors.clear();
    testing::assert_eq(testing::expect_ok(graph.predecessors(2), "snapshot").len(), 3);
    graph.loops()[0].blocks.clear();
    testing::assert(!graph.loops()[0].blocks.is_empty());
    testing::assert_err(graph.successors(-1));
    testing::assert_err(graph.dominates(0, 7));
    testing::assert_err(analysis::Graph::new(Vec::new(), Ref::new(100)));
    testing::assert_err(
        analysis::Graph::new(Vec::from_array([Vec::from_array([1])]), Ref::new(100)),
    );
    testing::assert_eq(
        testing::expect_err(analysis::Graph::new(edges, Ref::new(1)), "budget").kind,
        ir::ErrorKind::LimitExceeded,
    );
}

fn analysis_source(name: string) -> ir::Function {
    let builder = testing::expect_ok(
        ir::Builder::new(name, Vec::from_array([ir::Type::I64]), Vec::from_array([ir::Type::I64])),
        "builder",
    );
    let input = testing::expect_ok(builder.parameters(builder.entry()), "input")[0];
    let one = testing::expect_ok(builder.iconst(1), "one");
    let result = testing::expect_ok(builder.binary(ir::BinaryOp::Add, input, one), "add");
    let exit = testing::expect_ok(builder.append_block(Vec::from_array([ir::Type::I64])), "exit");
    testing::assert_ok(builder.jump(exit, Vec::from_array([result])));
    testing::assert_ok(builder.switch_to(exit));
    testing::assert_ok(builder.ret(testing::expect_ok(builder.parameters(exit), "result")));
    testing::expect_ok(builder.finish(), "function")
}

#[test]
fn analysis_caches_immutable_functions_tracks_edges_and_invalidates_replacements() -> () {
    let first = analysis_source("First");
    let second = analysis_source("Second");
    let context = analysis::Context::new();
    let analyzed = testing::expect_ok(context.analyze(first, Ref::new(10000)), "first analysis");
    let values = first.blocks()[0].instructions;
    let result = values[1].results[0];
    let site = testing::expect_ok(analyzed.uses(result), "edge use")[0];
    testing::assert(site.edge && site.block == 0 && site.position == 2);
    testing::assert_eq(testing::expect_ok(analyzed.definition(result), "definition").position, 1);
    testing::assert_ok(
        context.analyze_verified(testing::expect_ok(ir::verified(first), "verified"), Ref::new(1)),
    );
    testing::assert_eq(context.statistics().cache_hits, 1);
    testing::assert_ok(context.analyze(second, Ref::new(10000)));
    testing::assert_eq(context.statistics().builds, 2);
    testing::assert_eq(context.statistics().invalidations, 1);
    testing::assert(context.statistics().retained_capacity > 0);
    testing::assert(analyzed.function().same_identity(first));
    testing::assert(!analyzed.function().same_identity(second));
    testing::assert_eq(
        testing::expect_err(analyzed.uses(second.blocks()[0].parameters[0]), "foreign value").kind,
        ir::ErrorKind::WrongFunction,
    );
    context.clear();
    testing::assert_eq(context.statistics().invalidations, 2);
    testing::assert_ok(context.analyze(first, Ref::new(10000)));
    testing::assert_eq(context.statistics().builds, 3);
}
